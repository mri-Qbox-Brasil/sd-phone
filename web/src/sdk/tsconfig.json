{
    // The SDK is checked on its own, against its public contract (sdphone-sdk.d.ts). The phone's
    // tsconfig leaves this folder out so the contract's globals never leak into the phone's code.
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["./*.ts"],
    "exclude": ["./*.test.ts"]
}
